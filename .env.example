# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://valweb:change-me@localhost:5432/valweb
# Dedicated disposable database; integration tests delete fixture records here.
TEST_DATABASE_URL=postgresql://valweb:change-me@localhost:5432/valweb_test
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -hex 48
NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Required to deliver invitations and password recovery.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private persistent volume, outside public/. Defaults to var/assets.
IMAGE_STORAGE_DIR=

# Persist received CSV/ZIP privately; web and worker must share both volumes.
IMPORT_STORAGE_DIR=
# Bytes: 50 GiB received ZIP, 100 GiB expanded by default.
MAX_ZIP_BYTES=53687091200
MAX_EXPANDED_BYTES=107374182400
# Only behind a trusted proxy replacing X-Forwarded-For; deny direct access.
TRUST_PROXY=false
