{
  "name": "valweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:test": "node scripts/start-test-server.mjs",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node --import tsx tests/e2e/identity-smoke.ts",
    "test:e2e:validations": "node --import tsx tests/e2e/validations-smoke.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed-admin.ts",
    "images:cleanup": "node --import tsx scripts/cleanup-images.ts",
    "worker:imports": "node --import tsx scripts/import-worker.ts",
    "worker:test": "node --import tsx scripts/start-test-worker.mjs",
    "test:e2e:bulk": "node --import tsx tests/e2e/bulk-smoke.ts",
    "test:e2e:premium": "node --import tsx tests/e2e/premium-smoke.ts",
    "build:test": "node scripts/start-test-server.mjs build",
    "start:test": "node scripts/start-test-server.mjs start",
    "test:e2e:pwa": "node --import tsx tests/e2e/public-pwa-smoke.ts",
    "test:e2e:catalog": "node --import tsx tests/e2e/image-catalog-smoke.ts",
    "test:e2e:image-storage": "node --import tsx tests/e2e/image-storage-smoke.ts",
    "test:e2e:filters": "node --import tsx tests/e2e/identity-filters-smoke.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@fontsource/dm-sans": "^5.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "argon2": "^0.44.0",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.7.1",
    "next": "^16.0.0",
    "next-auth": "^4.24.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.0",
    "pg-boss": "^12.38.0",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.0.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "^3.5.13",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "playwright": "^1.64.1",
    "prisma": "^7.0.0",
    "smtp-server": "^3.21.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
